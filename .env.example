# AODT Worker and Client settings used by stages 00B-10B / 00BU-10BU.
AODT_CLIENT_ROOT=C:\path\to\aerial-omniverse-digital-twin
AODT_SCENE_ARCHIVE=C:\path\to\authorized-scene.zip

# AODT Worker gRPC endpoint. This is NOT the AI Server SSH address.
DT_SERVER_ADDRESS=CHANGE_ME_AODT_WORKER_IP:50051
AODT_S3_BUCKET=
AODT_S3_PROVIDER=minio
AODT_S3_ENDPOINT=
AODT_S3_ACCESS_KEY=
AODT_S3_SECRET_KEY=
AODT_S3_REGION=us-east-1
